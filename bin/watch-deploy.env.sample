# Settings for bin/watch-deploy.sh.
# Copy to .env at the repo root (gitignored) and edit for this host,
# or point the script elsewhere with ENV_FILE=/path/to/env.

# Image tarball to watch and load (required).
TARBALL=/<watched-directory>/turbo-jumbo.tar.gz

# Host path to the app config, mounted read-only at /config/config.yaml (required).
CONFIG_FILE=/<config-dir>/config.yaml

# Space-separated host directories mounted rw at the same path inside the
# container — model storage the config refers to (required).
MODEL_MOUNTS="/<base-models-dir> /<cold-storage-mountpoint-or-dir>"

# Host path of the Hugging Face token file mounted read-only into the
# container at /run/secrets/hf_token (default: hf_token.txt in the cwd).
#HF_TOKEN_FILE_HOST=/<config-dir>/hf_token.txt

# Optional overrides (defaults shown).
#CONTAINER_NAME=turbo-jumbo
#IMAGE_NAME=turbo-jumbo
#PORT=3000
#POLL_INTERVAL=2
#DEBOUNCE=1
