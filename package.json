{
  "name": "turbo-jumbo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "bun test",
    "docker:build": "podman build -t turbo-jumbo . && podman save turbo-jumbo | gzip > turbo-jumbo.tar.gz"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.1.2",
    "@astryxdesign/core": "^0.1.2",
    "@astryxdesign/theme-neutral": "^0.1.2",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "0.18.3",
    "ajv": "^8.20.0",
    "js-yaml": "^4.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@stylexswc/nextjs-plugin": "0.16.5",
    "@stylexswc/postcss-plugin": "0.16.5",
    "@stylexswc/swc-plugin": "0.5.1",
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@swc/core",
    "sharp",
    "unrs-resolver"
  ]
